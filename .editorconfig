root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Rust：4 空格，与 rustfmt.toml 的 max_width = 100 对齐（行宽由 rustfmt 管，这里不设）
[*.{rs}]
indent_size = 4
max_line_length = 100

# 文档与数据：Markdown 保留行尾空格（换行语义），2 空格缩进
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.json]
indent_size = 2

# Windows 脚本与 NSIS 脚本用 CRLF（Notepad 与 makensis 的默认预期）
[*.{ps1,psm1,bat,cmd,nsi,nsh}]
end_of_line = crlf
indent_size = 4

[*.ps1]
indent_size = 4
