# ---- Rust ----
/target/
**/*.rs.bk
*.pdb
*.exe.manifest

# ---- 构建/发布暂存 ----
/dist/
/installer/*-setup.exe
/installer/*.log
installer/*.tmp

# ---- 编辑器与 IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- 本地环境 ----
.env
.env.*
!.env.example
*.pfx
*.p12
*.cer
*.key
secrets/

# ---- 日志与本地调试产物 ----
*.log
*.dmp
logs/

# ---- 依赖缓存 ----
node_modules/
.cache/

# ---- 协作/代理工作区（本地草稿、工作日志、检索索引，不进仓库）----
/.scratch/
/.memsearch/
/.dsh/
/.dsh-compat/

# ---- 安装器 TRACE 兜底（2026-11-25 真实事故）----
# 成因：`/DTRACE=F:\git_project\...\trace.txt` 经 bash/WSL 传参时反斜杠被吃掉，
# 值退化成相对路径 `git_projectwasm...trace.txt`，于是落在**仓库根**。
# TRACE 的规矩是「编译期开关 + 仓库外的绝对路径」（见 docs/dev/release.md），
# 这条只是最后一道兜底：真出错时不要让脏文件进提交。
/git_project*

# 编译期 /DTRACE 传成 POSIX 形态时 makensis 会把反斜杠吃掉，落点变成仓库根下的
# mntfgit_projectwasm... 这类错位文件（task-54/64 实测）。兜底忽略，别让垃圾进提交。
/mntfgit_project*
